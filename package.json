{
  "name": "molv-os",
  "version": "0.1.0",
  "description": "墨绿OS — 跨平台 Linux 工作台、编译环境与应用中心",
  "main": "src/main/main.js",
  "author": {
    "name": "MolvOS Contributors",
    "email": "hello@molv.os"
  },
  "license": "MIT",
  "homepage": "https://github.com/molvos/molv-os",
  "repository": {
    "type": "git",
    "url": "https://github.com/molvos/molv-os.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "make:integrity": "node scripts/make-integrity.js",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:linux": "electron-builder --linux dir tar.gz --x64",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File android/build-apk.ps1",
    "cli": "node cli/main.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "isomorphic-git": "^1.44.13"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
}
